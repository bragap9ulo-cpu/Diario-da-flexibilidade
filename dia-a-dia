// ── TIMER ──
let tInt=null,tTotal=90,tLeft=90;
function startTimer(secs,name,type){
  clearInterval(tInt);tTotal=secs;tLeft=secs;
  document.getElementById('texname').textContent=name;
  document.getElementById('ttype').textContent=type;
  document.getElementById('tdone').classList.remove('show');
  document.getElementById('tov').classList.add('show');
  updTimer();
  tInt=setInterval(()=>{tLeft--;if(tLeft<=0){tLeft=0;updTimer();clearInterval(tInt);document.getElementById('tdone').classList.add('show');if(navigator.vibrate)navigator.vibrate([300,100,300]);}else updTimer();},1000);
}
function updTimer(){
  document.getElementById('tnum').textContent=tLeft;
  const arc=document.getElementById('tarc');
  arc.style.strokeDashoffset=CIRC*(1-tLeft/tTotal);
  arc.style.stroke=tLeft<=10?'#FF6B6B':tLeft<=30?'#F5A623':'#5CBF6A';
}
function adjTimer(d){tLeft=Math.max(5,tLeft+d);if(d>0&&tLeft>tTotal)tTotal=tLeft;updTimer();}
function stopTimer(){clearInterval(tInt);document.getElementById('tov').classList.remove('show');}

function ticoBtn(secs,label,type){
  if(!secs)return '';
  return `<button class="tmr-ico" onclick="startTimer(${secs},'${label.replace(/'/g,"\\'")}','${type}')"><svg width="15" height="15" viewBox="0 0 15 15" fill="none"><circle cx="7.5" cy="8.5" r="5.2" stroke="var(--text3)" stroke-width="1.2"/><path d="M7.5 5.5v3l1.8 1.1" stroke="var(--text3)" stroke-width="1.2" stroke-linecap="round"/><path d="M5.5 1.2h4M7.5 1.2v2" stroke="var(--text3)" stroke-width="1.2" stroke-linecap="round"/></svg></button>`;
}
