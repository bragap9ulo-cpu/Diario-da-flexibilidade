// ── RESTORE / RESET ──
function restorePlans(){
  if(!confirm('Restaurar treinos A, B e C com exercícios e calendário padrão?\n\nSeus lembretes e metas personalizados serão mantidos.'))return;
  const d=JSON.parse(JSON.stringify(DEF));
  S.planOrder=d.planOrder;
  S.plans=d.plans;
  S.restDay=d.restDay;
  S.sched=d.sched;
  EP=S.planOrder[0];
  save();render();
  alert('Treinos restaurados com sucesso! ✅');
}
function resetAll(){
  if(!confirm('⚠ Apagar TUDO e voltar ao estado inicial?\n\nEssa ação não pode ser desfeita.'))return;
  S=JSON.parse(JSON.stringify(DEF));
  EP=S.planOrder[0];
  save();render();
  alert('App resetado com sucesso! ✅');
}

// ── PLAN MANAGEMENT ──
function addPlan(){
  const next=LETTERS.split('').find(l=>!S.planOrder.includes(l));
  if(!next)return;
  S.plans[next]={name:'Treino '+next,rest:75,exs:[],cardio:[],cardioRest:30};
  S.planOrder.push(next);
  EP=next;save();render();
}
function deletePlan(key){
  if(S.planOrder.length<=1){alert('Precisa ter pelo menos um treino.');return;}
  if(!confirm('Excluir Treino '+key+'? Os dias agendados com ele serão limpos.'))return;
  delete S.plans[key];
  S.planOrder=S.planOrder.filter(k=>k!==key);
  for(const dk in S.sched){if(S.sched[dk]===key)delete S.sched[dk];}
  EP=S.planOrder[0];
  save();render();
}

// ── ACTIONS ──
function updEx(id,f,v){
  for(const k in S.plans){
    if(!S.plans[k].exs)continue;
    const e=S.plans[k].exs.find(x=>x.id===id);
    if(e){e[f]=v;break;}
  }
  save();
}
function delEx(id){
  for(const k in S.plans){
    if(!S.plans[k].exs)continue;
    const idx=S.plans[k].exs.findIndex(e=>e.id===id);
    if(idx>=0){S.plans[k].exs.splice(idx,1);break;}
  }
  save();render();
}
function addEx(){
  if(!S.plans[EP])return;
  S.plans[EP].exs.push({id:uid(),nm:'Novo exercício',sets:3,reps:'10',kg:0});
  save();render();
}
function addPlanCardio(){
  const inp=document.getElementById('cai');
  if(!inp||!inp.value.trim())return;
  if(!S.plans[EP].cardio)S.plans[EP].cardio=[];
  S.plans[EP].cardio.push({id:uid(),tx:inp.value.trim()});
  inp.value='';save();render();
}
function delPlanCardio(id){
  S.plans[EP].cardio=S.plans[EP].cardio.filter(c=>c.id!==id);
  save();render();
}
function addRestCardio(){
  const inp=document.getElementById('rcai');
  if(!inp||!inp.value.trim())return;
  if(!S.restDay.cardio)S.restDay.cardio=[];
  S.restDay.cardio.push({id:uid(),tx:inp.value.trim()});
  inp.value='';save();render();
}
function delRestCardio(id){
  S.restDay.cardio=S.restDay.cardio.filter(c=>c.id!==id);
  save();render();
}
function assignDay(key){
  // Toggle: if day already has selected plan, remove it
  if(!CSEL||CSEL==='X'){
    delete S.sched[key];
  } else if(S.sched[key]===CSEL){
    delete S.sched[key]; // ← toggle off clicking same plan
  } else {
    S.sched[key]=CSEL;
  }
  save();render();
}
function addRem(){const i=document.getElementById('ri');if(!i||!i.value.trim())return;S.reminders.push(i.value.trim());i.value='';save();render();}
function delRem(i){S.reminders.splice(i,1);save();render();}
function addMeta(){const i=document.getElementById('mi');if(!i||!i.value.trim())return;S.metas.push({id:uid(),tx:i.value.trim()});i.value='';save();render();}
function addMetaCfg(){const i=document.getElementById('mci');if(!i||!i.value.trim())return;S.metas.push({id:uid(),tx:i.value.trim()});i.value='';save();render();}
function delMeta(id){S.metas=S.metas.filter(m=>m.id!==id);save();render();}

function render(){setHdr();({hoje:vHoje,treinos:vTreinos,cal:vCal,lemb:vLemb}[VIEW]||vHoje)();}
document.getElementById('bnav').addEventListener('click',e=>{
  const item=e.target.closest('[data-v]');if(!item)return;
  VIEW=item.dataset.v;
  document.querySelectorAll('.nav-item').forEach(n=>n.classList.remove('act'));
  item.classList.add('act');render();
});
render();
</script>
